{
  "name": "init-to-winit26",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#ingestion/*": "./ingestion/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:remote-data": "CLOUDFLARE_REMOTE_DATA=1 vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "terrain:download-copernicus": "bash scripts/download-copernicus-caribbean.sh",
    "terrain:validate-source": "bash scripts/validate-copernicus-source.sh",
    "terrain:generate": "node scripts/generate-copernicus-terrain.mjs",
    "terrain:prepare-webp": "bash scripts/prepare-terrain-webp.sh",
    "terrain:validate-release": "node scripts/validate-terrain-release.mjs",
    "terrain:preview-local": "node scripts/preview-terrain-local.mjs",
    "dev:local-terrain": "VITE_TERRAIN_TILE_URL=http://localhost:4174/api/tiles/{z}/{x}/{y}.webp vite dev --port 3001 --strictPort",
    "terrain:publish": "bash scripts/publish-terrain.sh",
    "cf:typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply yaad-guard --local",
    "db:migrate:remote": "wrangler d1 migrations apply yaad-guard --remote",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test e2e/cloudflare-port.spec.ts",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.21",
    "@tanstack/router-plugin": "^1.168.15",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.40.0",
    "nitro": "3.0.260603-beta",
    "nitropack": "^2.13.4",
    "react": "^19.2.7",
    "react-doctor": "^0.4.2",
    "react-dom": "^19.2.7",
    "react-map-gl": "^8.1.1",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.0",
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@cloudflare/workers-types": "^4.20260605.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/devtools-vite": "^0.7.0",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
